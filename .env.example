DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://casino:casino@localhost:5432/casino_index
REDIS_URL=redis://localhost:6379/0

# Crawler etiquette
CRAWLER_USER_AGENT=FrequencyIndexBot/1.0 (+https://example.com/bot; research contact: data@example.com)
CRAWLER_REQUEST_TIMEOUT=20
CRAWLER_DELAY_SECONDS=4
CRAWLER_RESPECT_ROBOTS=1

# Nightly run, Europe/Madrid local time
CRAWL_HOUR=3
CRAWL_MINUTE=30

SCRAPER_MODE=mock
