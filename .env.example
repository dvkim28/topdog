DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://casino:casino@localhost:5432/casino_index
REDIS_URL=redis://localhost:6379/0

# Crawler etiquette
CRAWLER_USER_AGENT=FrequencyIndexBot/1.0 (+https://example.com/bot; research contact: data@example.com)
CRAWLER_REQUEST_TIMEOUT=20
CRAWLER_DELAY_SECONDS=4
CRAWLER_RESPECT_ROBOTS=1

# Playwright network-sniffing scraper (index/services/scraper.py)
NETWORK_SNIFF_TIMEOUT=5
NETWORK_URL_PATTERNS=/games,/lobby,/tiles,/api/casino,/casino/api

# Tier 2 title matching + AI extraction fallback (Claude). Unset = AI disabled,
# both paths fall back to CSS selectors / human review only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cheaper model used for Tier 2 title matching only (a classification task,
# not full-page extraction) - see index/services/normalization.py.
ANTHROPIC_MATCH_MODEL=claude-haiku-4-5

# Redis DB used to dedupe Tier 2 AI matcher calls across brands in a run.
# Defaults to REDIS_URL's host with DB index 1 (REDIS_URL itself is DB 0,
# the Celery broker) - only set this if you need a different instance/DB.
REDIS_CACHE_URL=

# Nightly run, Europe/Madrid local time
CRAWL_HOUR=3
CRAWL_MINUTE=30

SCRAPER_MODE=mock
